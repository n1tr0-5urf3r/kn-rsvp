# Copy to .env and fill in the blanks. Read by docker-compose (env_file).

# --- Branding ---
APP_NAME=RSVP
APP_SUBTITLE="Hardware reservations"
APP_TAGLINE="Reserve shared lab hardware and understand the testbed at a glance."
# Optional URL served by the app, a remote URL, or a data URL. To keep a local
# logo private, place it in ${DATA_DIR}/branding and use /branding/logo.png.
APP_LOGO_URL=
APP_FAVICON_URL=/favicon.svg

# --- Management topology (optional) ---
# Comma-separated, case-insensitive label/prefix preferences. Values containing
# spaces should be quoted, as shown here.
TOPOLOGY_SWITCH_ORDER=
TOPOLOGY_UPLINK_LABELS=
TOPOLOGY_PREFERRED_UPLINK=
TOPOLOGY_CENTRAL_NODE=

# --- Networking ---
# Host port that docker-compose publishes; nginx proxies to this.
HOST_PORT=4343

# --- Storage ---
# Host directory bind-mounted at /app/data; holds the SQLite file rsvp.db.
DATA_DIR=./data
# Public URL the site is served under (used for OIDC redirect + cookies).
PUBLIC_BASE_URL=http://localhost:4343

# --- Authentik OIDC ---
AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/rsvp/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Optional: derived from PUBLIC_BASE_URL when unset.
#AUTHENTIK_REDIRECT_URI=http://localhost:4343/api/v1/auth/callback
AUTHENTIK_SCOPES="openid profile email groups"
AUTHENTIK_GROUPS_CLAIM=groups

# --- Authorization ---
# Comma-separated group names (normalized: lowercased, non-alphanumerics stripped,
# so "Lab Staff" and "lab-staff" both match "labstaff"). Empty = any authenticated user.
AUTH_ALLOWED_GROUPS=members,admins
# Members of these groups get admin rights.
AUTH_ADMIN_GROUPS=admins

# --- Sessions ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
# Session lifetime in hours (168 = 7 days).
AUTH_SESSION_TTL_HOURS=168

# --- Misc ---
# Dev-mode login bypass (GET /api/v1/auth/dev-login). MUST be 0 in production.
AUTH_DEV_MODE=0
RUST_LOG=rsvp=info,tower_http=info
TIMEZONE=UTC
# Stable metadata used in generated iCalendar events.
CALDAV_PRODUCT_ID="-//RSVP//Hardware reservations//EN"
CALDAV_UID_DOMAIN=localhost
# Optional Docker Compose host override for an OIDC provider without public DNS.
OIDC_EXTRA_HOST=host.docker.internal:host-gateway
